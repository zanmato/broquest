def route(method, path):
    """Return (status, body) for a request, body None for an empty reply."""
    if method == "GET" and path == "/health":
        return 200, {"status": "ok", "version": "2026.9.4"}
    if method == "POST" and path == "/v1/auth/token":
        return 200, TOKEN
    if method == "GET" and path == "/v1/shipments":
        return 200, {"data": SHIPMENTS, "has_more": True, "next_cursor": "c_48102"}
    match = re.fullmatch(r"/v1/shipments/(KS-\d+)", path)
    if match and method == "GET":
        return 200, SHIPMENT_DETAIL
    if match and method == "DELETE":
        return 204, None
    if method == "POST" and path == "/v1/shipments":
        return 201, {**SHIPMENT_DETAIL, "id": "KS-48231", "status": "label_created", "events": []}
    if method == "POST" and path == "/v1/rates/quote":
        return 200, RATES
    if method == "GET" and path == "/v1/webhooks":
        return 200, WEBHOOKS
    if method == "PUT" and path.startswith("/v1/webhooks/"):
        return 200, WEBHOOKS["data"][0]
    return 404, {"error": "not_found", "message": f"No route for {method} {path}"}


class Handler(BaseHTTPRequestHandler):
    server_version = "kestrel-gateway/2.4"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def handle_any(self):
        length = int(self.headers.get("Content-Length") or 0)
        if length:
            self.rfile.read(length)
        time.sleep(DELAY_SECONDS)
        status, body = route(self.command, self.path.split("?", 1)[0])
        payload = b"" if body is None else json.dumps(body, ensure_ascii=False).encode()
        self.send_response(status)
        if body is not None:
            self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("X-Request-Id", "req_01J9KX4M2B7Q")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    do_GET = do_POST = do_PUT = do_PATCH = do_DELETE = handle_any

    def date_time_string(self, timestamp=None):
        return "Thu, 01 Oct 2026 09:41:00 GMT"

    def log_message(self, format, *args):
        pass


def main():
    port = int(sys.argv[1])
    ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


if __name__ == "__main__":
    main()
